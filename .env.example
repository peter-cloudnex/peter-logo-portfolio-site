# Public site origin used for canonical URLs, Open Graph, sitemap, and robots.
# Example: https://peterlogo.dev
NEXT_PUBLIC_SITE_ORIGIN=

# Domain registered in your Plausible site settings (no protocol).
# Example: peterlogo.dev
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=

# Optional: set to true to send analytics from local/dev builds (for verifying events).
# NEXT_PUBLIC_PLAUSIBLE_TRACK_LOCALHOST=false
